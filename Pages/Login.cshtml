@page
@model community_db.Pages.LoginModel

<h2>Log In</h2>

<form method="post">
    <input asp-for="Email" placeholder="Email" required />
    <button type="submit">Login</button>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p style="color:red">@Model.ErrorMessage</p>
    }
</form>



