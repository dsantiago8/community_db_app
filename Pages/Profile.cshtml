@page
@model community_db.Pages.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>


@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<form method="post">
    <div class="mb-3">
        <label for="Name" class="form-label">Name</label>
        <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name" required />
    </div>

    <div class="mb-3">
        <label for="Email" class="form-label">Email</label>
        <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" required />
    </div>

    <button type="submit" class="btn btn-primary">Update Profile</button>
</form>

<form method="post" asp-page-handler="Logout">
    <button type="submit" class="btn btn-danger mt-3">Logout</button>
</form>


<h3 class="mt-4">Saved Listings</h3>

@if (Model.SavedListings.Count == 0)
{
    <p>You haven't saved any listings yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var listing in Model.SavedListings)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <a asp-page="/ListingDetails" asp-route-id="@listing.ListingId">@listing.Title</a>
                    <br />
                    <small class="text-muted">
                        @listing.CategoryName • @listing.LocationName • Posted @listing.DatePosted.ToShortDateString()
                    </small>
                </div>
                <form method="post" asp-page-handler="Unsave" asp-route-id="@listing.ListingId" class="ms-3">
                    <button class="btn btn-sm btn-outline-danger">Unsave</button>
                </form>
            </li>
        }
    </ul>
}
