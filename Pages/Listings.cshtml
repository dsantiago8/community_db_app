@page
@using community_db.Pages
@model ListingsModel


@{
    ViewData["Title"] = "Community Listings";
}

@if (TempData["WelcomeMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["WelcomeMessage"]
    </div>
}

<h1>Community Listings</h1>

<h2>New Listing</h2>

@* Listing Form *@
<form method="post">
    @Html.AntiForgeryToken()
    
    <input asp-for="NewListing.Title" placeholder="Title" required maxlength="100" />

    <select asp-for="NewListing.CategoryId">
        @foreach (var category in Model.Categories)
        {
            <option value="@category.CategoryId">@category.Name</option>
        }
    </select>

    <select asp-for="NewListing.LocationId">
        @foreach (var location in Model.Locations)
        {
            <option value="@location.LocationId">@location.Name</option>
        }
    </select>

    <textarea asp-for="NewListing.Description" placeholder="Description" required maxlength="1000"></textarea>
    <input asp-for="NewListing.EventDate" type="date" class="form-control"/>


    <button type="submit">Add Listing</button>
</form>

<h2>Filters</h2>

@* Filter *@
<form method="get" class="mb-3">
    <div class="d-flex flex-wrap gap-2">
        <input type="text" name="title" class="form-control" placeholder="Search by Title" value="@Request.Query["title"]" />

        <input type="text" name="userEmail" class="form-control" placeholder="User Email" value="@Request.Query["userEmail"]" />
        
        <select name="categoryId" class="form-select">
            <option value="">All Categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.CategoryId" selected="@(Request.Query["categoryId"] == category.CategoryId.ToString() ? "selected" : null)">
                    @category.Name
                </option>

            }
        </select>

        <select name="locationId" class="form-select">
            <option value="">All Locations</option>
            @foreach (var location in Model.Locations)
            {
                <option value="@location.LocationId" selected="@(Request.Query["locationId"] == location.LocationId.ToString() ? "selected" : null)">
                    @location.Name
                </option>

            }
        </select>
        <input type="date" name="eventDate" class="form-control" value="@Request.Query["eventDate"]" />


        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>



<hr />

@* Show Listings *@
@foreach (var item in Model.Listings)
{
    <div>
        <h3>
            <a asp-page="/ListingDetails" asp-route-id="@item.ListingId">
                @item.Title (@item.CategoryName)
            </a>
        </h3>
        <p>@item.Description</p>
        <p><em>@item.LocationName</em> • Date Posted: @item.DatePosted.ToShortDateString()</p>
        <p><strong>Posted by:</strong> @item.CreatorEmail</p>
        <p><strong>Event Date:</strong> @(item.EventDate.HasValue ? item.EventDate.Value.ToShortDateString() : "N/A")</p>


        @if (HttpContext.Session.GetInt32("UserId") is int userId)
        {
            var alreadyJoined = item.Signups?.Any(s => s.UserId == userId) == true;

            <form method="post" asp-page-handler="@(alreadyJoined ? "Leave" : "Join")" asp-route-id="@item.ListingId">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm @(alreadyJoined ? "btn-danger" : "btn-success")">
                    @(alreadyJoined ? "Leave" : "Join")
                </button>
            </form>

            <form method="post" asp-page-handler="@(item.SavedByUser ? "Unsave" : "Save")" asp-route-id="@item.ListingId">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm @(item.SavedByUser ? "btn-warning" : "btn-outline-warning")">
                    @(item.SavedByUser ? "Unsave" : "Save")
                </button>
            </form>
        }

        @if (item.Signups?.Count > 0)
            {
                <p><strong>@item.Signups.Count user(s) joined:</strong></p>
                <ul>
                    @foreach (var s in item.Signups)
                    {
                        <li>@s.UserEmail</li>
                    }
                </ul>
            }

    </div>
   


    <hr />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.querySelector('form[method="get"]').addEventListener('submit', function (e) {
            const title = document.querySelector('input[name="title"]').value.trim();
            const email = document.querySelector('input[name="userEmail"]').value.trim();
            const category = document.querySelector('select[name="categoryId"]').value;
            const location = document.querySelector('select[name="locationId"]').value;
            const eventDate = document.querySelector("input[name='eventDate']").value;

            const isAllEmpty = !title && !email && !category && !location && !eventDate;

            if (isAllEmpty) {
                e.preventDefault(); // Stop form from submitting
                alert("Please enter at least one filter before searching.");
            }
        });
    </script>
}

