@page "{id:int}"
@model community_db.Pages.ListingDetailsModel
@{
    ViewData["Title"] = "Listing Details";
}

<h1>@Model.CurrentListing?.Title</h1>

<p>@Model.CurrentListing?.Description</p>
<p><strong>Posted by:</strong> @Model.CurrentListing?.CreatorEmail</p>
<p><strong>Posted on:</strong> @Model.CurrentListing?.DatePosted.ToShortDateString()</p>
<p><strong>Event Date:</strong> @(Model.CurrentListing?.EventDate?.ToShortDateString() ?? "N/A")</p>
<p><strong>Views:</strong> @Model.CurrentListing?.ViewCount</p>

@if (HttpContext.Session.GetInt32("UserId") != null && Model.CurrentListing?.CreatorId != HttpContext.Session.GetInt32("UserId"))
{
    <h4>Send a Message to the Creator</h4>
    <form method="post" asp-page-handler="SendMessage" asp-route-id="@Model.CurrentListing.ListingId">
        <textarea name="MessageContent" class="form-control" rows="3" required placeholder="Write your message here..."></textarea>
        <button type="submit" class="btn btn-primary mt-2">Send Message</button>
    </form>
}

<hr />
<h3>Comments</h3>

@if (Model.Comments.Count == 0)
{
    <p>No comments yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var comment in Model.Comments)
        {
            <li class="list-group-item mb-1">
                <strong>@comment.UserName</strong> <small class="text-muted">(@comment.CreatedAt)</small>
                <br />
                @comment.Content
            </li>
        }
    </ul>
}

@if (HttpContext.Session.GetInt32("UserId") != null)
{
    <form method="post" asp-page-handler="AddComment" asp-route-id="@Model.CurrentListing.ListingId">
        <div class="mb-3 mt-4">
            <label for="NewComment" class="form-label">Add a comment:</label>
            <textarea asp-for="NewComment" class="form-control" id="NewComment" rows="3" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Post Comment</button>
    </form>
}
else
{
    <p class="mt-3"><a href="/Login">Log in</a> to comment.</p>
}


